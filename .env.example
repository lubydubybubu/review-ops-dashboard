# Copy to .env.local and fill in. Never commit real values. (Production: deploy/ops.env.example + docs/DEPLOYMENT.md)

# Local-only tool: keep Next.js telemetry off.
NEXT_TELEMETRY_DISABLED=1

# Runtime connection (use a role with DML grants only — see README "DB roles").
# DATABASE_URL_FILE=/path/to/secret is read instead when set.
DATABASE_URL=postgres://ops_app:change-me@127.0.0.1:5432/review_ops

# Optional: owner connection used only by `npm run db:migrate` and `npm run db:seed`.
# Falls back to DATABASE_URL when unset. MIGRATION_DATABASE_URL_FILE also works.
MIGRATION_DATABASE_URL=postgres://ops_owner:change-me@127.0.0.1:5432/review_ops

# Exact origin the browser uses for Ops (http only for 127.0.0.1/localhost outside production).
OPS_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Sign-in mode. Unset = sign-in disabled (fail closed). See docs/AUTH.md.
#   demo-password  local demo / tests only (refused with OPS_DEPLOYMENT=production)
#   site           one-time handoff from the parent site's ADMIN login (member logins never)
OPS_AUTH_MODE=demo-password

# demo-password: output of `npm run hash-password` (format: scrypt:N:r:p:salt:hash, base64url).
OPS_PASSWORD_HASH=

# site mode (all required; values are placeholders). OPS_PUBLIC_ORIGIN must be same-site with SITE_ORIGIN.
# OPS_IDENTITY_KIND=admin
# SITE_ORIGIN=https://site.example
# SITE_CLIENT_ID=review-ops
# SITE_CLIENT_SECRET_FILE=/path/to/client-secret   (or SITE_CLIENT_SECRET=…, ≥32 random chars)
# OPS_AUTH_REVALIDATE_SECONDS=30   (0–120: max delay before an admin logout / password change ends Ops sessions)

# Mail-request ingest (POST /api/ingest/mail-candidates). Off unless a token hash AND the allowed host are set.
# `npm run ingest-token -- --out ./ingest-token` writes a token file (0600) and prints its SHA-256.
# OPS_INGEST_TOKEN_SHA256=<64 hex>      (or OPS_INGEST_TOKEN_SHA256_FILE=/path/to/hash)
# OPS_INGEST_ALLOWED_HOST=127.0.0.1:3000 (required: exact Host header of the producer's requests, host:port;
#                                         requests with any other Host or a cf-connecting-ip / cf-ray header → 401)
# OPS_INGEST_ALLOWED_CIDRS=127.0.0.1/32  (optional; TCP peer address, needs `node --import ./scripts/peer-address.mjs`)
# OPS_INGEST_RATE_PER_MINUTE=60
