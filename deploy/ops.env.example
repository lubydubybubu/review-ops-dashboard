# Copy to deploy/ops.env on the Ops host. Placeholders only — no secrets in this file.
OPS_IMAGE=review-ops:REPLACE_WITH_GIT_SHA
OPS_MIGRATE_IMAGE=review-ops-migrate:REPLACE_WITH_GIT_SHA
# Must be same-site with SITE_ORIGIN (e.g. a subdomain of the site's domain): the parent-site admin cookie is
# SameSite=Strict, so a cross-site Ops origin never gets the admin session through (docs/AUTH.md).
OPS_PUBLIC_ORIGIN=https://ops.site.example
# The host the admin logs in on (its host-only admin cookie must be present there).
SITE_ORIGIN=https://site.example
SITE_CLIENT_ID=review-ops
OPS_AUTH_REVALIDATE_SECONDS=30
OPS_TRUSTED_CLIENT_IP_HEADER=
