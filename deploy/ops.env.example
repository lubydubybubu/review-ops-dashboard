# Copy to deploy/ops.env on the Ops host. Placeholders only — no secrets in this file.
OPS_IMAGE=review-ops:REPLACE_WITH_GIT_SHA
OPS_MIGRATE_IMAGE=review-ops-migrate:REPLACE_WITH_GIT_SHA
# Must be same-site with SITE_ORIGIN (e.g. a subdomain of the site's domain): the parent-site admin cookie is
# SameSite=Strict, so a cross-site Ops origin never gets the admin session through (docs/AUTH.md).
OPS_PUBLIC_ORIGIN=https://ops.site.example
# The host the admin logs in on (its host-only admin cookie must be present there).
SITE_ORIGIN=https://site.example
SITE_CLIENT_ID=review-ops
OPS_AUTH_REVALIDATE_SECONDS=30
OPS_TRUSTED_CLIENT_IP_HEADER=
# Mail-request ingest (docs/DEPLOYMENT.md "Mail ingest"). The token hash is the secret file
# deploy/secrets/ops_ingest_token_sha256 (64 hex = SHA-256 of the producer's token); the token itself stays
# on the producer's host. Leave the file empty to keep ingest off.
# Where the producer reaches Ops over the LAN: <host LAN address>:<port> (default: loopback only, i.e. off).
OPS_INGEST_PUBLISH=127.0.0.1:3100
# TCP peer addresses allowed to POST, comma-separated CIDRs, e.g. the producer host only: 192.0.2.30/32
OPS_INGEST_ALLOWED_CIDRS=
# Required for ingest: the exact Host header of the producer's requests = OPS_INGEST_PUBLISH's host:port,
# e.g. 192.0.2.20:3100 (and the producer's OPS_INGEST_URL=http://192.0.2.20:3100). Never the public
# hostname. Empty = ingest refuses every POST (the app itself starts and runs normally).
OPS_INGEST_ALLOWED_HOST=
OPS_INGEST_RATE_PER_MINUTE=60
